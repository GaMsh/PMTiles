{
	admin off
	auto_https off
	skip_install_trust

	servers :80 {
		protocols h1 h2c
	}
}

:80 {
	log {
		output stdout
		format console
	}

	handle_path /tiles/* {
		reverse_proxy https://cdn.pmtiles.ru {
			header_up Host cdn.pmtiles.ru
			flush_interval -1
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		file_server
	}
}
